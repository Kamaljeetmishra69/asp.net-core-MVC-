
@using Microsoft.AspNetCore.Mvc.Rendering
@using udemy.Models.ViewModel
@model ProductVM

<div class="container-fluid py-3">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-plus-lg me-2"></i>@if (Model.Product.Id != 0)
                {
                    <span>Update</span>
                }
                else
                {
                    <span>Create</span>
                }
                Product
            </h5>
            <p class="mb-0 small" style="color: #1DB954;">
                @if (Model.Product.Id != 0)
                {
                    <span> Edit Product detail</span>
                }
                else
                {
                    <span>Add a new products</span>
                }
            </p>
        </div>
        <div class="card-body p-4">
            <form asp-action="Upsert"
                  asp-controller="Product"
                  method="post"
                  enctype="multipart/form-data">
              <div class="row">
                <div class="col-lg-8">
                    <input asp-for="Product.Id" type="hidden" />
                        <input asp-for="Product.ImageUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Product.Title" class="form-label fw-semibold small"></label>
                            <input asp-for="Product.Title" class="form-control" placeholder="Enter Product name" required />
                           <div class="Quill-editor"></div>
                            <span asp-validation-for="Product.Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Product.Description" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Product.Description" id="Description" hidden class="form-control" placeholder="Enter Description"> </textarea>
                                <div id="quill-editor" style="height:250px;"></div>
                            <span asp-validation-for="Product.Description" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Product.ISBN" class="form-label fw-semibold small"></label>
                            <input asp-for="Product.ISBN" class="form-control" placeholder="Enter ISBN" required />
                            <span asp-validation-for="Product.ISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Product.Author" class="form-label fw-semibold small"></label>
                            <input asp-for="Product.Author" class="form-control" placeholder="Enter Author name" required />
                            <span asp-validation-for="Product.Author" class="text-danger small"></span>
                        </div>
                        <div class="col-3">
                            <label asp-for="Product.Price" class="form-label fw-semibold small"></label>
                            <input asp-for="Product.Price" class="form-control" required />
                            <span asp-validation-for="Product.Price" class="text-danger small"></span>
                        </div>
                        <div class="col-3">
                            <label asp-for="Product.ListPrice" class="form-label fw-semibold small"></label>
                            <input asp-for="Product.ListPrice" class="form-control" required />
                            <span asp-validation-for="Product.ListPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-3">
                            <label asp-for="Product.Price50" class="form-label fw-semibold small"></label>
                            <input asp-for="Product.Price50" class="form-control" required />
                            <span asp-validation-for="Product.Price50" class="text-danger small"></span>
                        </div>
                        <div class="col-3">
                            <label asp-for="Product.Price100" class="form-label fw-semibold small"></label>
                            <input asp-for="Product.Price100" class="form-control" required />
                            <span asp-validation-for="Product.Price100" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Product.CategoryId" class="form-label"></label>
                            <select asp-for="Product.CategoryId" asp-items="@Model.CategoryList" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Product.ImageUrl" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-image"></i>
                                </span>

                                <input type="file"
                                       name="File"
                                       class="form-control"
                                       accept="image/*" />
                            </div>
                            
                        </div>
                    </div>
                </div>
                <!--image-->
                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-header text-white text-center rounded-top-4" style="background-color:#006400">
                                <h6 class="mb-0">Current Image</h6>
                            </div>

                            <div class="card-body d-flex flex-column justify-content-center align-items-center">

                                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                                {
                                    <img src="@Model.Product.ImageUrl"
                                         class="img-fluid rounded-3 border shadow"
                                         style="max-height:300px; object-fit:cover;"
                                         alt="Product Image" />

                                    <small class="text-muted mt-3">
                                        Upload a new image to replace the current one.
                                    </small>
                                }
                                else
                                {
                                    <div class="text-center py-5">
                                        <i class="bi bi-image text-secondary"
                                           style="font-size:5rem;"></i>

                                        <h6 class="mt-3 text-secondary">
                                            No Image Available
                                        </h6>

                                        <small class="text-muted">
                                            Upload an image to preview it here.
                                        </small>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
              </div>
               

                
               
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">
                        @if (Model.Product.Id != 0)
                        {
                            <span>Update</span>
                        }
                        else
                        {
                            <span>Craete</span>
                        }
                         Product
                    </button>
                    <a href="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts
{
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        var quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: 'Enter Description...'
        });

        // Load existing value (Edit page)
        var description = document.getElementById("Description").value;
        if (description) {
        quill.root.innerHTML = description;
        }

        // Save HTML into textarea before submit
        document.querySelector("form").addEventListener("submit", function () {
        document.getElementById("Description").value = quill.root.innerHTML;
        });

        });
    </script>
}