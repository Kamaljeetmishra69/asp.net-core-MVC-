@model List< Udemy.Models.Models.Product>

<div class="container">
    <div class="row  pt-2">
        <div class="col-6">
            <h2 class="text-primary">Product list</h2>
        </div>
        <div class="col-6 text-decoration-underline text-end">
            <a asp-action="Create" class=" btn btn-primary">
                <i class="bi bi-plus-circle">create new Product</i>
            </a>
        </div>


    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Title</th>

                <th>ISBN</th>

                <th>Author</th>

                <th>Listprice</th>

                <th>Category</th>

                <th></th>

            </tr>
        </thead>
        <tbody>

            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Title</td>
                    <td>@obj.ISBN</td>
                    <td>@obj.Author</td>
                    <td>@obj.ListPrice</td>
                    <td></td>
                    
                    <td>
                        <div class="w-50 btn-group " role="group">
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@obj.Id" class=" btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i>Edit
                            </a>
                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@obj.Id" class=" btn btn-danger mx-2">
                                <i class="bi bi-trash3"></i>Delete
                            </a>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>



