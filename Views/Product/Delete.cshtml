@using udemy.Models.Models
@model Product
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h4 class="mb-0">Delete Category</h4>
                </div>

                <div class="card-body p-4">

                    <form method="post" class="row">
                        <input asp-for="Id" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title"
                                   disabled class="form-control form-control-lg"
                                   placeholder="Enter category name" />
                            @* <span asp-validation-for="Title" class="text-danger small"></span> *@
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <input asp-for="Description"
                                    disabled class="form-control form-control-lg"
                                   placeholder="Enter display order" />
                            @* <span asp-validation-for="Description" class="text-danger small"></span> *@
                        </div>
                        <div class="mb-4">
                            <label asp-for="ISBN" class="form-label fw-semibold"></label>
                            <input asp-for="ISBN"
                                    disabled class="form-control form-control-lg"
                                   placeholder="Enter display order" />
                            @* <span asp-validation-for="ISBN" class="text-danger small"></span> *@
                        </div>
                        <div class="mb-4">
                            <label asp-for="Author" class="form-label fw-semibold"></label>
                            <input asp-for="Author"
                                    disabled class="form-control form-control-lg"
                                   placeholder="Enter display order" />
                            @* <span asp-validation-for="Author" class="text-danger small"></span> *@
                        </div>
                        <div class="mb-4">
                            <label asp-for="ListPrice" class="form-label fw-semibold"></label>
                            <input asp-for="ListPrice"
                                    disabled class="form-control form-control-lg"
                                   placeholder="Enter display order" />
                            @* <span asp-validation-for="ListPrice" class="text-danger small"></span> *@
                        </div>
                        <div class="mb-4">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price"
                                   disabled class="form-control form-control-lg"
                                   placeholder="Enter display order" />
                            @* <span asp-validation-for="Price" class="text-danger small"></span> *@
                        </div>
                        <div class="mb-4">
                            <label asp-for="Price50" class="form-label fw-semibold"></label>
                            <input asp-for="Price50"
                                    disabled class="form-control form-control-lg"
                                   placeholder="Enter display order" />
                            @* <span asp-validation-for="Price50" class="text-danger small"></span> *@
                        </div>
                        <div class="mb-4">
                            <label asp-for="Price100" class="form-label fw-semibold"></label>
                            <input asp-for="Price100"
                                   disabled class="form-control form-control-lg"
                                   placeholder="Enter display order" />
                            @* <span asp-validation-for="Price100" class="text-danger small"></span> *@
                        </div>


                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle"></i> Delete
                            </button>

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Back to List
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

